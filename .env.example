# Runtime
CORS_ALLOW_ORIGINS=http://127.0.0.1:8081,http://localhost:8081,http://127.0.0.1:8080,http://localhost:8080

# DynamoDB. The podcasts table is created by Terraform with partition key `id`
# and on-demand billing; there is no connection string and no password, because
# the table is reached with the execution role. There is no local emulator
# either, so local runs talk to the real table in AWS_REGION.
DYNAMODB_PODCASTS_TABLE=applepie-podcasts
# AWS. Bedrock and Polly authenticate with the Lambda execution role in deployment
# and the ambient AWS profile locally -- no key belongs in this file. Locally, if
# credentials come from `aws login`, export them first:
#   eval "$(aws configure export-credentials --format env)"
AWS_REGION=us-east-1
# Nova Pro: every GPT-6/GPT-5.6 and Claude 5.x model is listed in the account's
# Bedrock catalogue but returns "not available for this account" when invoked.
BEDROCK_SCRIPT_MODEL=amazon.nova-pro-v1:0
# A truncated response is invalid JSON, so this guards correctness, not just cost.
BEDROCK_SCRIPT_MAX_TOKENS=2048
# Polly emits headerless PCM; PollyTTSClient adds the WAV header so the merge step
# keeps working through the stdlib wave module and ffmpeg stays out of the image.
POLLY_ENGINE=generative
POLLY_SAMPLE_RATE=16000
POLLY_VOICE_HOST_A=Ruth
POLLY_VOICE_HOST_B=Matthew
# fal.ai is the one AI dependency deliberately left outside AWS (cover art).
FAL_KEY=
# Set by Terraform instead of the value above. A secret value in a Lambda
# environment variable would be written to Terraform state in plaintext, so the
# deployment passes the Secrets Manager ARN and the service resolves it at
# startup. Leave blank locally and use the plain value above.
FAL_KEY_SECRET_ARN=

# S3. Bucket for generated podcast audio and cover art, created by Terraform.
S3_PODCAST_BUCKET=applepie-podcasts
# Objects stay private. Read URLs are presigned per response with this lifetime;
# the stored URL is always the unsigned one, so a record cannot rot into a dead
# link (E52). With no resolvable AWS credentials the signer degrades to unsigned
# URLs rather than failing the request.
PRESIGNED_URL_TTL_MINUTES=60

PODCAST_MAX_CHUNKS=40
PODCAST_MAX_SCRIPT_PARTS=12
PODCAST_TIMEOUT_SECONDS=120

# S3 Vectors. Shared across every ApplePie service that reads or writes story
# chunks: data-ingestion writes, story-labeling-api labels, this service reads.
# Created by Terraform.
S3_VECTOR_BUCKET=
S3_VECTOR_INDEX=apple-pie-story-chunks
VECTOR_LIST_BATCH_SIZE=500

# Audio merging uses pydub. Podcast clips are WAV, which pydub reads and writes
# through the standard library, so ffmpeg is only needed for other codecs.
# Background podcast jobs are best-effort only.
# They are not durable across restarts, so keep the process alive or retry work from the client.
