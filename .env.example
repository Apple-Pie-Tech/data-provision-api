# Azure PostgreSQL Flexible Server
CORS_ALLOW_ORIGINS=http://127.0.0.1:8081,http://localhost:8081,http://127.0.0.1:8080,http://localhost:8080
# az postgres flexible-server create --resource-group <resource-group> --name <server-name> --location <azure-region> --admin-user <admin-user> --admin-password <admin-password> --sku-name Standard_B1ms --tier Burstable --public-access 0.0.0.0
# Use sslmode=require, for example:
# DATABASE_URL=postgresql://<user>:<password>@<server>.postgres.database.azure.com:5432/<database>?sslmode=require
DATABASE_URL=
OPENAI_API_KEY=
SLNG_API_KEY=
FAL_KEY=

# Azure Blob Storage
# az storage container create --account-name applepieingestaudio --name podcasts --auth-mode login
AZURE_STORAGE_ACCOUNT=applepieingestaudio
AZURE_STORAGE_CONTAINER=podcasts
AZURE_STORAGE_CONNECTION_STRING=

PODCAST_MAX_CHUNKS=40
PODCAST_MAX_SCRIPT_PARTS=12
PODCAST_TIMEOUT_SECONDS=120

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=data_provision_points

# Audio merging uses pydub and requires ffmpeg installed and available on PATH.
# Background podcast jobs are best-effort only.
# They are not durable across restarts, so keep the process alive or retry work from the client.
